# APP
APP_ENV=dev
APP_URL=http://localhost

# JWT AUTH
# REQUIRED — generate with: openssl rand -base64 32
JWT_SECRET_KEY=
JWT_EXPIRATION_TIME=3600

# CORS
CORS_ALLOW_ORIGIN=http://localhost:3000

# DATABASE
DB_TYPE=mariadb
DB_USERNAME=nest
DB_PASSWORD=nest
DB_HOST=db
DB_PORT=3306
DB_DATABASE=nest
DB_SYNC=false